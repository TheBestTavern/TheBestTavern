  <GivingText>k__BackingField: "\uCCAB \uBC88\uC9F8\uB85C \uB9C8\uB298\uC744 \uB2E4\uC9C4
    \uB9C8\uB298\uB85C \uB9CC\uB4E4\uC5B4\uBCFC\uAE4C?<page>\uB9C8\uB298\uC744 \uB2E4\uC9C0\uB294
    \uBC29\uBC95\uC740 \uC77C\uBC18\uC801\uC73C\uB85C\uB294 \uC9C1\uC811 \uC2E4\uD5D8\uD574\uAC00\uBA70
    \uCC3E\uC544\uC57C\uD558\uC9C0\uB9CC,<page>\uC774\uBC88\uB9CC \uD2B9\uBCC4\uD788
    \uC54C\uB824\uC8FC\uC790\uBA74 \uC808\uAD6C\uC5D0 \uB123\uACE0 \uCC27\uC73C\uBA74
    \uB3FC~<page>\uC870\uC120\uC758 \uBC29\uC2DD\uC774\uB77C \uC870\uAE08 \uC0DD\uC18C\uD560
    \uC218\uB3C4 \uC788\uC9C0\uB9CC \uD654\uC774\uD305!"
  <FollowingText>k__BackingField: "\uC644\uC131\uD588\uAD6C\uB098? \uC808\uAD6C\uB97C
    \uB2E4\uB8E8\uB294 \uAC8C \uC5B4\uB835\uC9C0\uB294 \uC54A\uC558\uC5B4?<page>\uC774\uB807\uAC8C
    \uC6D0\uC7AC\uB8CC\uC778 \uB9C8\uB298\uC744 \uC801\uC808\uD55C \uB3C4\uAD6C\uB97C
    \uD1B5\uD574\uC11C \uAC00\uACF5\uD558\uBA74 <\uAC00\uACF5\uC7AC\uB8CC>\uC778
    \uB2E4\uC9C4 \uB9C8\uB298\uC774 \uB3FC!<page><\uAC00\uACF5\uC7AC\uB8CC>\uB294
    \uB3C4\uAC10\uC5D0 \uBCC4\uB3C4\uB85C \uB4F1\uB85D\uB418\uC9C0 \uC54A\uC73C\uB2C8\uAE4C
    \uAE4C\uBA39\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uB77C\uAD6C~<page>\uC774\uC81C
    \uC721\uC218\uB97C '\uC870\uD569'\uD560 \uBAA8\uB4E0 \uC7AC\uB8CC\uAC00 \uBAA8\uC600\uB124?"
