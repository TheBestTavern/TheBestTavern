  <GivingText>k__BackingField: "\uC774\uC81C \uC644\uC131\uB41C \uC694\uB9AC\uB97C
    \uD765\uBD80\uC5D0\uAC8C \uC804\uB2EC\uD558\uBA74 \uBB34\uCC99 \uAE30\uBED0\uD560\uAC70\uC57C!<page>\uD765\uBD80\uAC00
    \uCC3E\uC544\uC624\uB294 \uB0A0\uC740 Tab-\uC758\uB8B0\uB780\uC5D0\uC11C \uD655\uC778\uD560
    \uC218 \uC788\uB294 \uAC70 \uAE30\uC5B5\uD558\uC9C0?<page>\uD639\uC2DC\uB77C\uB3C4
    \uC774\uBBF8 \uC758\uB8B0\uB97C \uC2E4\uD328\uD588\uB2E4\uBA74, \uC2E4\uD328\uC77C\uB85C\uBD80\uD130
    5\uC77C \uD6C4\uC5D0 \uB2E4\uC2DC \uC758\uB8B0\uAC00 \uB4E4\uC5B4\uC624\uB2C8\uAE4C
    \uCC38\uACE0\uD574\uC918.<page>\uB0A0\uC9DC\uB97C \uB118\uAE30\uACE0 \uC2F6\uB2E4\uBA74
    \uC6B0\uCE21 \uD558\uB2E8\uC758 \uC774\uBD88\uC744 \uD074\uB9AD\uD574\uBD10."
  <FollowingText>k__BackingField: "\uC694\uB9AC\uB97C \uC798 \uC804\uB2EC\uD588\uAD6C\uB098!<page>\uD765\uBD80\uAC00
    \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00\uC11C \uC694\uB9AC\uB97C \uB9DB\uBCF4\uACE0,
    \uB0B4\uC77C\uC774\uBA74 \uC6B0\uB9AC\uC5D0\uAC8C \uACB0\uACFC\uB97C \uC54C\uB824\uC904\uAC70\uC57C."
