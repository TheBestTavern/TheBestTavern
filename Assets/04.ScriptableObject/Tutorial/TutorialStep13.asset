  <GivingText>k__BackingField: "\uADF8\uB7EC\uB2C8 \uC7A0\uAE50 \uD55C\uC228 \uC790\uBCFC\uAE4C?<page>\uC6B0\uCE21
    \uD558\uB2E8\uC5D0 \uC788\uB294 \uC774\uBD88\uC744 \uB20C\uB7EC\uC11C \uD558\uB8FB\uBC24\uC744
    \uBCF4\uB0B8 \uB4A4\uC5D0 \uD3B8\uC9C0\uD568\uC758 \uACB0\uACFC\uB780\uC5D0\uC11C
    \uACB0\uACFC \uD3B8\uC9C0\uB97C \uC77D\uC5B4\uBD10."
  <FollowingText>k__BackingField: "\uC218\uACE0\uD588\uC5B4! \uB178\uB825\uC5D0 \uAC78\uB9DE\uB294
    \uACB0\uACFC\uC600\uAE38 \uBC14\uB77C.<page>NPC\uC758 \uBCF4\uC0C1\uC740 \uB124\uAC00\uC9C0
    \uB2E8\uACC4\uAC00 \uC788\uC5B4. <\uC2E4\uD328> <\uC18C\uC131\uACF5> <\uC911\uC131\uACF5>
    <\uB300\uC131\uACF5><page>- <\uC2E4\uD328>\uD558\uBA74 \uD638\uAC10\uB3C4\uAC00
    \uAE4E\uC77C \uC218 \uC788\uC73C\uB2C8 \uC870\uC2EC\uD574\uC57C\uD574.<page>-
    <\uC18C\uC131\uACF5>\uC740 \uD638\uAC10\uB3C4\uAC00 \uC870\uAE08 \uC62C\uB77C\uAC00.<page>-
    <\uC911\uC131\uACF5>\uC740 \uC911\uAC04 \uD638\uAC10\uB3C4 \uC0C1\uC2B9\uACFC
    \uD568\uAED8 '\uD2B9\uC218\uC7AC\uB8CC'\uB97C \uD68D\uB4DD\uD560 \uC218 \uC788\uC5B4.<page>-
    <\uB300\uC131\uACF5>\uC740 \uD070 \uD638\uAC10\uB3C4 \uC0C1\uC2B9\uACFC \uD568\uAED8
    '\uD2B9\uC218\uC7AC\uB8CC'\uB97C \uD68D\uB4DD\uD560 \uC218 \uC788\uC5B4.<page>-
    \uCC38\uACE0\uB85C, <\uD2B9\uC218\uC7AC\uB8CC>\uB294 \uC758\uB8B0 \uC644\uB8CC\uB97C
    \uD1B5\uD574\uC11C\uB9CC \uC5BB\uC744 \uC218 \uC788\uB294 \uD2B9\uBCC4\uD55C
    \uC7AC\uB8CC\uC57C.<page>\uB9CC\uC57D \uD2B9\uC218\uC7AC\uB8CC\uAC00 \uB5A8\uC5B4\uC9C0\uBA74
    \uB2E4\uC2DC \uADF8 NPC\uC758 \uC758\uB8B0\uB97C \uC644\uC218\uD574\uC57C\uD574.<page>\uC544,
    \uADF8\uB9AC\uACE0 \uB2E4\uB978 NPC\uB4E4\uC758 \uC758\uB8B0\uB3C4 \uBC1B\uACE0
    \uC2F6\uB2E4\uBA74, \uAE30\uC874 NPC\uB4E4\uC758 \uD638\uAC10\uB3C4\uB97C \uB192\uC5EC\uC57C\uD574<page>\uC5B4\uB5A4
    NPC\uB4E4\uC774 \uC5B4\uB5A4 \uC694\uB9AC\uB97C \uBD80\uD0C1\uD560\uC9C0 \uBC8C\uC368\uBD80\uD130
    \uAE30\uB300 \uB418\uC9C0\uC54A\uC544?<page>\uC548\uB41C\uB2E4\uACE0? \uADF8\uB798\uB3C4
    \uC5B4\uCA54 \uC218 \uC5C6\uC5B4~ \uD604\uC2E4\uC5D0 \uB3CC\uC544\uAC00\uB824\uBA74
    \uB2E4 \uD574\uC57C\uC9C0!<page>\uB0B4\uAC00 \uC54C\uB824\uC904 \uAC83\uC740
    \uC5EC\uAE30\uAE4C\uC9C0\uC57C. \uB098\uB294 \uC55E\uC73C\uB85C \uD558\uB298\uC5D0\uC11C
    \uB124\uAC00 \uD574\uB098\uAC00\uB294 \uBAA8\uC2B5\uC744 \uC9C0\uCF1C\uBCF4\uAE30\uC5D4
    \uB108\uBB34 \uBC14\uBE60\uC11C! \uC774\uB9CC!!@@@@@@@@@@@@@@@@@@"
