  <GivingText>k__BackingField: "\uC774\uC81C \uC644\uC131\uB41C \uC694\uB9AC\uB97C
    \uD765\uBD80\uC5D0\uAC8C \uC804\uB2EC\uD558\uBA74 \uBB34\uCC99 \uAE30\uBED0\uD560
