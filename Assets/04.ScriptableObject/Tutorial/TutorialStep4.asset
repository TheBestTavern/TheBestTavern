  <TutorialStepID>k__BackingField: 910004
  <StepName>k__BackingField: "\uB124\uBC88\uC9F8 \uC5F0\uC2B5"
  <NextTutorialStepID>k__BackingField: 910005
  <TutorialObjectives>k__BackingField:
  - stepName: "\uB3C4\uAC10\uC5D0\uC11C \uC721\uC218\uC758 \uC0C1\uC138 \uC815\uBCF4
      \uBCF4\uAE30"
    objectiveDoType: 2
    tutorialCountType: 0
    detail: FoodDetail
    targetCount: 1
  <GivingText>k__BackingField: "\uB108\uB3C4 \uBD24\uB2E4\uC2DC\uD53C \uC6B0\uB9AC\uAC00
    \uC900\uBE44\uD574\uC57C \uD560 \uC7AC\uB8CC\uB294 \uC721\uC218, \uCA84\uC9C4
    \uAD74, \uBBF8\uC5ED \uC138 \uAC00\uC9C0 \uC7AC\uB8CC\uC778\uB370, \uC7AC\uB8CC\uC5D0\uB3C4
    \uAC01\uAC01\uC758 \uACE0\uC720\uD55C <\uC885\uB958>\uAC00 \uC788\uB2E4\uB294
    \uC0AC\uC2E4\uC774 \uC911\uC694\uD574.<page>\uC774\uBC88 \uC758\uB8B0 \uAC19\uC740
    \uACBD\uC6B0 \uAC01\uAC01\uC758 \uC7AC\uB8CC\uB4E4\uC758 '\uC885\uB958'\uAC00
    \uBAA8\uB450 \uB2EC\uB77C\uC11C \uADF8\uAC78 \uC775\uD788\uB294 \uB370 \uC544\uC8FC
    \uC720\uC6A9\uD560 \uAC70\uC57C.<page>\uC138\uC0C1\uC758 \uC7AC\uB8CC\uB4E4\uC740
    \uBAA8\uB450 \uB124 \uAC00\uC9C0 \uC885\uB958\uC57C. '\uC6D0\uC7AC\uB8CC', '\uAC00\uACF5\uC7AC\uB8CC',
    '\uC870\uD569\uC7AC\uB8CC', '\uD2B9\uC218\uC7AC\uB8CC'.<page>\uAC01\uAC01\uC774
    \uC5B4\uB5A4 \uC5ED\uD560\uC778\uC9C0\uB294 \uC55E\uC73C\uB85C \uD558\uB098\uD558\uB098
    \uC775\uD600\uAC00 \uBCF4\uC790\uACE0~<page>\uADF8\uB7FC \uC77C\uB2E8 \uC6B0\uB9AC
    '\uC721\uC218' \uC7AC\uB8CC\uC5D0 \uB300\uD574\uC11C \uC54C\uC544\uBCFC\uAE4C?
    \uC721\uC218\uC5D0 \uB300\uD55C \uC815\uBCF4\uB294 Tab-\uB3C4\uAC10-\uC870\uD569\uC7AC\uB8CC\uC5D0\uC11C
    \uD655\uC778\uD560 \uC218 \uC788\uC5B4!"
  <FollowingText>k__BackingField: "\uC790, \uBC29\uAE08 \uB124\uAC00 \uBCF4\uACE0
    \uC628 \uC721\uC218\uB294 <\uC870\uD569\uC7AC\uB8CC>\uB85C\uC11C \uD544\uC694\uD55C
    \uC7AC\uB8CC\uB97C \uC870\uD569\uD574\uC11C \uC5BB\uC744 \uC218 \uC788\uB294
    \uC7AC\uB8CC\uC57C! <\uC870\uD569\uC7AC\uB8CC>\uB294 \uC7AC\uB8CC\uC784\uC5D0\uB3C4
    \uC5EC\uB7EC \uC7AC\uB8CC\uB97C \uC870\uD569\uD574\uC11C \uC5BB\uC5B4\uC57C \uD558\uB294
    \uAE4C\uB2E4\uB85C\uC6B4 \uB140\uC11D\uC774\uC57C."
