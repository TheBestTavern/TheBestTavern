  <TutorialObjectives>k__BackingField:
  - stepName: "\uB3C4\uAC10\uC5D0\uC11C \uC721\uC218\uC758 \uC0C1\uC138 \uC815\uBCF4
      \uBCF4\uAE30"
    objectiveDoType: 2
    tutorialCountType: 0
    detail: FoodDetail
    targetCount: 1
  <GivingText>k__BackingField: "\uB108\uB3C4 \uBD24\uB2E4\uC2DC\uD53C \uC6B0\uB9AC
    \uC900\uBE44\uD574\uC57C\uD560 \uC7AC\uB8CC\uB294 \uC721\uC218, \uCA84\uC9C4
    \uAD74, \uBBF8\uC5ED 3\uAC00\uC9C0 \uC7AC\uB8CC\uC57C.<page>\uAC01\uAC01\uC758
    \uC7AC\uB8CC\uB97C \uC5BB\uB294 \uBC29\uBC95\uC740 \uC7AC\uB8CC\uC758 \uC885\uB958\uBCC4\uB85C
    \uB2E4\uC591\uD574.<page>(TMI)\uCC44\uC9D1\uC744 \uD1B5\uD574 \uD55C\uBC88\uC5D0
    \uC5BB\uC744 \uC218 \uC788\uB294 \u2018\uC6D0\u2019\uC7AC\uB8CC<page>(TMI)\uC7AC\uB8CC\uB97C
    \uB3C4\uAD6C\uB97C \uD1B5\uD574 \uAC00\uACF5\uD558\uB294 '\uAC00\uACF5'\uC7AC\uB8CC<page>(TMI)\uC7AC\uB8CC\uB07C\uB9AC
    \uC870\uD569\uD574\uC11C \uC81C\uC791\uD558\uB294 '\uC870\uD569'\uC7AC\uB8CC<page>(TMI)NPC\uC758
    \uC758\uB8B0\uB97C \uC644\uC218\uD574\uC11C \uC5BB\uC744 \uC218 \uC788\uB294
    '\uD2B9\uC218'\uC7AC\uB8CC\uC57C.<page>(TMI)\uC989, \uC6D0\uC7AC\uB8CC-\uAC00\uACF5\uC7AC\uB8CC-\uC870\uD569\uC7AC\uB8CC-\uD2B9\uC218\uC7AC\uB8CC
    \uC774\uB807\uAC8C 4\uAC00\uC9C0 \uC885\uB958\uAC00 \uC788\uC9C0.<page>\uC5EC\uD558\uD2BC,
    \uC774\uBC88 \uC758\uB8B0\uAC19\uC740 \uACBD\uC6B0\uC5D0\uB294 \uAC01\uAC01\uC758
    \uC7AC\uB8CC\uB4E4\uC758 <\uC885\uB958>\uAC00 \uBAA8\uB450 \uB2EC\uB77C\uC11C,
    \uC7AC\uB8CC\uB97C \uC775\uD788\uB294 \uB370 \uC544\uC8FC \uC720\uC6A9\uD560\uAC70\uC57C.<page>\uC55E\uC73C\uB85C
    \uD558\uB098 \uD558\uB098\uC529 \uC775\uD600\uAC00\uBCF4\uC790\uACE0~<page>\uADF8\uB7FC
    \uC77C\uB2E8\uC740 \uC6B0\uB9AC '\uC721\uC218' \uC7AC\uB8CC\uC5D0 \uB300\uD574\uC11C
    \uC54C\uC544\uBCFC\uAE4C?<page>\uC721\uC218\uC5D0 \uB300\uD55C \uC815\uBCF4\uB294,
    Tab-\uB3C4\uAC10-\uC870\uD569\uC7AC\uB8CC\uC5D0\uC11C \uD655\uC778\uD560 \uC218
    \uC788\uC5B4!"
  <FollowingText>k__BackingField: "\uBD24\uB2E4\uC2DC\uD53C \uC721\uC218\uB294 \uBA78\uCE58,
    \uB2E4\uC9C4\uB9C8\uB298, \uC2DD\uC218\uB97C \uC870\uD569\uD574\uC11C \uC5BB\uB294
    <\uC870\uD569\uC7AC\uB8CC>\uC57C.<page><\uC870\uD569\uC7AC\uB8CC>\uB294 \uC7AC\uB8CC\uC784\uC5D0\uB3C4
    \uC5EC\uB7EC \uD558\uC704 \uC7AC\uB8CC\uB97C \uC870\uD569\uD574\uC11C \uC5BB\uC5B4\uC57C\uD558\uB294
    \uAE4C\uB2E4\uB85C\uC6B4 \uB140\uC11D\uC774\uC57C.<page>\uADF8\uB9AC\uACE0 \uB3C4\uAC10\uC5D0\uC11C\uB294
    <\uC870\uD569\uC7AC\uB8CC>\uC5D0 \uB300\uD55C \uB808\uC2DC\uD53C\uB97C \uBAA8\uB450
    \uD655\uC778\uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C \uCC38\uACE0\uD558\uB77C\uACE0!"
